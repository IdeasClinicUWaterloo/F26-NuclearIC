// test_spectro.ino
// Bench test for the AS7265x + external emitter LED transmittance setup --
// confirms the sensor is detected and shows the raw sensor readings with
// the emitter LED held on, before integrating into
// dye_concentration_controller_as7265x.ino.
//
// NOTE: this file lives in the same sketch folder as
// dye_concentration_controller_as7265x.ino. Arduino compiles every .ino in
// a folder together as one sketch, so only have ONE of these two files
// present (or open) at a time -- both define setup()/loop() and will not
// compile together.
//
// ELECTRICAL NOTE: the AS7265x is a 3.3V device. On the R4 Minima this is
// fine to wire directly -- its Renesas RA4M1 runs I/O at 3.3V natively, so
// no I2C level shifter is needed. Power the sensor from the board's 3.3V
// pin, not 5V -- same wiring as the main controller sketch.
//
// RAW ONLY: printing just the uncalibrated 16-bit counts (getX()) for
// D/E/F/G/H (485-585nm) -- that's where all the real signal showed up in
// the full-spectrum test. No on/off subtraction -- LED is held on
// continuously, so keep room lighting steady between readings you compare.

#include <Wire.h>
#include "SparkFun_AS7265X.h"

AS7265X sensor;

const int EMITTER_LED_PIN = 11; // -> resistor (~220-330 ohm) -> LED anode; cathode -> GND

void setup() {
  Serial.begin(115200);
  Wire.begin();

  pinMode(EMITTER_LED_PIN, OUTPUT);
  digitalWrite(EMITTER_LED_PIN, HIGH); // held on for this version

  if (sensor.begin() == false) {
    Serial.println("AS7265x not detected -- check wiring/3.3V power.");
    while (1);
  }

  sensor.disableBulb(AS7265x_LED_WHITE);
  sensor.disableBulb(AS7265x_LED_IR);
  sensor.disableBulb(AS7265x_LED_UV);

  Serial.println("AS7265x detected. Emitter LED held on, printing raw readings...");
  Serial.println("rawD,rawE,rawF,rawG,rawH");
}

void loop() {
  sensor.takeMeasurements();

  uint16_t rawD = sensor.getD(), rawE = sensor.getE(), rawF = sensor.getF();
  uint16_t rawG = sensor.getG(), rawH = sensor.getH();

  Serial.print(rawD); Serial.print(",");
  Serial.print(rawE); Serial.print(",");
  Serial.print(rawF); Serial.print(",");
  Serial.print(rawG); Serial.print(",");
  Serial.println(rawH); // println here -- this is what actually flushes the line

  delay(200);
}
